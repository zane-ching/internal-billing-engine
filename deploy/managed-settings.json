{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel-billing.internal.cyclotron.com:4318",
    "OTEL_METRIC_EXPORT_INTERVAL": "60000",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "true",
    "OTEL_EXPORTER_OTLP_HEADERS": "X-Billing-Token=REPLACE_WITH_FLEET_BILLING_TOKEN",
    "CLAUDE_BILLING_RECEIVER": "https://otel-billing.internal.cyclotron.com:4318",
    "CLAUDE_BILLING_TOKEN": "REPLACE_WITH_FLEET_BILLING_TOKEN"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "/opt/cyclotron/claude-repo-tag.py" }] }
    ],
    "CwdChanged": [
      { "hooks": [{ "type": "command", "command": "/opt/cyclotron/claude-repo-tag.py" }] }
    ],
    "DirectoryAdded": [
      { "hooks": [{ "type": "command", "command": "/opt/cyclotron/claude-repo-tag.py" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/opt/cyclotron/claude-repo-tag.py" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "/opt/cyclotron/claude-repo-tag.py", "async": true }] }
    ]
  }
}
